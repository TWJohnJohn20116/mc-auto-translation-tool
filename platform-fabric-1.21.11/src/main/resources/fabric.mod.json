{
  "schemaVersion": 1,
  "id": "universal_translator",
  "version": "${version}",
  "name": "MC Auto Translation Tool",
  "description": "Client-side automatic translation for server-provided text across Minecraft interfaces.",
  "authors": [
    "MC Auto Translation Tool contributors"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.universaltranslator.fabric.UniversalTranslatorFabricClient"
    ]
  },
  "mixins": [
    "universal-translator.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
