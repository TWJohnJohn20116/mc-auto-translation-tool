  },
  "license": "MIT",
  "environment": "client",
  "jars": [
    {"file": "META-INF/jars/universal-translator-1.16.jar"},
    {"file": "META-INF/jars/universal-translator-1.16.1.jar"},
    {"file": "META-INF/jars/universal-translator-1.16.2.jar"},
    {"file": "META-INF/jars/universal-translator-1.16.3.jar"},
