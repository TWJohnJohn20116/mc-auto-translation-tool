{
  "schemaVersion": 1,
  "id": "universal_translator",
  "version": "${version}",
  "name": "MC Auto Translation Tool",
  "description": "Client-side automatic translation for server-provided text across Minecraft interfaces.",
  "authors": [
    "我小张7272635"
  ],
  "contact": {
    "homepage": "https://space.bilibili.com/3546631091783712",
    "sources": "https://github.com/wuxiangdan96-byte/mc-auto-translation-tool"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.universaltranslator.fabric.UniversalTranslatorFabricClient"
    ],
    "modmenu": [
      "org.universaltranslator.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "universal-translator.fabric.mixins.json"
  ],
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
